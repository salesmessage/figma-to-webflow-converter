# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Logs
*.log

# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Google Indexing API service account key — never commit this
.google-indexing-key.json

# Claude Code — personal/local overrides only (team-shared settings.json is committed)
.claude/settings.local.json

# Figma assets staged for upload to Webflow — regenerate with /build, don't commit
assets/

# Per-PAGE working files only — the build specs for the sections of one page.
# Everything durable was moved to site/. This folder can be deleted once a page is
# signed off, without orphaning a single reference. Delete it to reset for a new page.
project/

# Snapshot of the reference page this build was matched against (see README, "Parity mode").
# COMMITTED, deliberately, and against the usual rule about third-party downloads.
# The page it came from is a temporary A/B variant that will not exist later, so this
# snapshot is the ONLY surviving evidence for the ~20 decisions in project/FIGMA-DELTAS.md
# category B. It is not regenerable. 693 KB. See reference/README.md.
#   reference/        <- intentionally NOT ignored

# Scratch: published-page downloads, generated embed payloads, upload indexes.
# Everything here is disposable and regenerable.
.work/

# NOT ignored, for the record: brand/ is the reusable brand library — logos, icons,
# tokens, fonts, and the registers of Webflow asset/component/variable/font IDs.
# It outlives any single job. See brand/README.md.

# NOT ignored, for the record: site/ is the durable record of THIS Webflow site —
# tokens, site map, image manifest, delta register, parity log, asset-folder IDs, and
# the shared Header/Footer specs. Every later page of this site is built from it.
# See site/README.md.
